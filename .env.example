# Optional settings for `docker compose up`.
# Copy this file to `.env` (same folder) and uncomment what you need; Docker Compose
# reads `.env` automatically on macOS, Linux and Windows alike.

# Host ports (change any that are already in use on your machine)
# API_PORT=8080
# WORKER_PORT=9091
# MOCK_PROVIDER_PORT=8090
# PROMETHEUS_PORT=9090
# JAEGER_UI_PORT=16686
# RABBITMQ_UI_PORT=15672

# Send notifications to webhook.site instead of the bundled mock provider
# PROVIDER_URL=https://webhook.site/your-uuid

# Mock provider behaviour (to watch retries and the circuit breaker)
# MOCK_FAILURE_RATE=0.05
# MOCK_LATENCY_MS=30
# MOCK_LATENCY_JITTER_MS=40
